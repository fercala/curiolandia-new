#!/bin/sh
# Gancho de git que aplica la política de documentación (docs/POLITICA-DOCUMENTACION.md) y la de diálogos
# (dialogos/LEEME.md). Se activa solo con `npm install` / `npm ci` (script "prepare": git config core.hooksPath
# herramientas/git-hooks); a mano: git config core.hooksPath herramientas/git-hooks
# 1. Si el commit cambia código (.js, .ts o .mts de src/ o herramientas/), comprueba que todas las funciones tengan
#    comentario (tests/comentarios.py).
# 2. Si cambia src/ pero ningún documento (docs/, README.md, CLAUDE.md), para el commit para que no se olvide.
# 3. Si el texto de alguna llamada a say(), sayQ(), say3(), sayMix() o sayMix3() de src/ es nuevo o cambia
#    (frases_diff.py) y no toca dialogos/pendientes.txt, para el commit: cada diálogo nuevo o cambiado se apunta.
# 4. Si toca dialogos/pendientes.txt, también tiene que tocar el catálogo dialogos/todos.csv.
# Para saltárselo en un caso justificado: git commit --no-verify, y explícalo en el mensaje del commit.
cambios=$(git diff --cached --name-only --diff-filter=ACMRD)
if echo "$cambios" | grep -q '^dialogos/pendientes.txt$' && ! echo "$cambios" | grep -q '^dialogos/todos.csv$'; then
  echo "Tocas dialogos/pendientes.txt pero no dialogos/todos.csv: añade allí las frases nuevas (dialogos/LEEME.md)." >&2
  exit 1
fi
echo "$cambios" | grep -q -E '^(src|herramientas)/.*\.(js|ts|mts)$' || exit 0
python3 tests/comentarios.py || {
  echo "Falta documentar código (ver arriba). Lee docs/POLITICA-DOCUMENTACION.md." >&2; exit 1; }
echo "$cambios" | grep -q '^src/' || exit 0
echo "$cambios" | grep -q -e '^docs/' -e '^README.md$' -e '^CLAUDE.md$' || {
  echo "Cambias src/ pero ningún documento. Actualiza docs/ (como mínimo docs/CAMBIOS.md)." >&2
  echo "Si de verdad no hace falta, usa git commit --no-verify y explícalo en el mensaje." >&2; exit 1; }
# frases de say() nuevas o cambiadas en las líneas de código del commit (no basta con tocar una línea que habla)
habla=$(python3 herramientas/git-hooks/frases_diff.py)
if [ -n "$habla" ] && ! echo "$cambios" | grep -q '^dialogos/pendientes.txt$'; then
  echo "Estas frases de say() son nuevas o cambian, pero no tocas dialogos/pendientes.txt:" >&2
  echo "$habla" | sed 's/^/  /' >&2
  echo "Apúntalas en dialogos/pendientes.txt y en dialogos/todos.csv (dialogos/LEEME.md)." >&2
  echo "Si ya estaban apuntadas, usa git commit --no-verify y explícalo." >&2
  exit 1
fi
exit 0
